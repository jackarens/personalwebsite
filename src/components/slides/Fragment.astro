---
interface Props {
	class?: string;
	as?: "span" | "li" | "div" | "tr" | "p";
	/** Explicit reveal order, for fragments nested out of DOM order. */
	index?: number;
	/** Mark as full-bleed so the overflow guard skips it. */
	"data-bleed"?: boolean;
}

const { class: className, as: Element = "span", index, ...rest } = Astro.props;
---

<Element class:list={["fragment", className]} data-fragment-index={index} {...rest}>
	<slot />
</Element>
